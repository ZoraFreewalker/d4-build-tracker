{
  "name": "d4-tracker",
  "productName": "D4 Build Tracker",
  "version": "1.2.2",
  "description": "Diablo IV build tracker overlay",
  "author": "karim",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "import": "node importer.mjs",
    "test": "node --test",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "allowScripts": {
    "electron@33.2.1": true
  },
  "build": {
    "appId": "local.karim.d4buildtracker",
    "productName": "D4 Build Tracker",
    "files": [
      "main.mjs",
      "importer.mjs",
      "tracker.mjs",
      "library.mjs",
      "board.mjs",
      "preload.cjs",
      "overlay.html",
      "control.html",
      "icon.png",
      "package.json",
      "capture.html"
    ],
    "extraResources": [
      {
        "from": "ocr.ps1",
        "to": "ocr.ps1"
      },
      {
        "from": "focus.ps1",
        "to": "focus.ps1"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "D4 Build Tracker",
      "artifactName": "D4-Build-Tracker-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ZoraFreewalker",
        "repo": "d4-build-tracker"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
